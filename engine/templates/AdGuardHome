#!/bin/sh /etc/rc.common
START=95
STOP=01
USE_PROCD=1

start_service() {
    [ -s /etc/AdGuardHome.yaml ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/AdGuardHome/AdGuardHome \
        -c /etc/AdGuardHome.yaml -w /usr/bin/AdGuardHome -l /tmp/AdGuardHome.log
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="65535 65535"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/AdGuardHome.yaml
    procd_close_instance
}
